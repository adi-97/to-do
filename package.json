{
  "name": "todo-app",
  "productName": "Todo",
  "version": "1.0.0",
  "description": "A snazzy personal to-do list desktop app",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "author": "Aditya",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aditya.todo",
    "productName": "Todo",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Aditya <adityaravi234@gmail.com>",
      "synopsis": "A snazzy personal to-do list"
    }
  }
}
